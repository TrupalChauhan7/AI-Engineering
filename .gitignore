# --- Secrets (NEVER commit) ---
.env

# --- Python ---
__pycache__/
*.py[cod]
.ipynb_checkpoints/
*.egg-info/
.pytest_cache/

# --- Environments ---
.venv/
env/

# --- Generated outputs (regenerated by rerunning code) ---
results/
!results/.gitkeep

# --- Large data (Git LFS / 2GB audio) ---
primock57/audio/*.wav

# --- OS junk ---
.DS_Store

# --- PriMock57 dataset: NOT committed (third-party data, reproducible via download) ---
# Repos hold YOUR code, not someone else's dataset. Keep only our helper + guide.
primock57/*
!primock57/download_audio.py
!primock57/DATASET_GUIDE.md
.Rhistory

# Office lock/temp files
~$*

# --- Fine-tuning (Track B): large weights + downloadable data, not code ---
# local model checkpoints (e.g. medgemma-4b-it-4bit, ~2.8 GB)
models/
# MTS-Dialog CSVs + formatted JSONL (re-fetchable + regenerable)
data/mts_dialog/

# --- Synthetic reliability probe (exploratory, self-built dataset) ---
# The 43 consultation scripts, copied verbatim from Created_dataset/Keys/.
# Same policy as primock57/* and data/mts_dialog/: repos hold code, not data.
data/synthetic/
# The injection DETAIL LOG and the note/fact cache contain clinical text
# (which sentences were planted / deleted, and the generated notes). They live
# under results/, which is already ignored in full — listed explicitly so the
# data-safety intent is on the record rather than incidental.
results/synth_probe_injection_log.jsonl
results/synth_probe_cache.json

# Local agent config
.claude/

# --- Clarion demo app ---
# node deps + build output
app/web/node_modules/
app/web/.next/
app/web/out/
# DATA SAFETY: cached sample results contain PriMock57 transcript + note text.
# Regenerate locally with scripts/build_samples.py. NEVER commit these.
app/web/public/samples/

# --- Knowledge-graph scratch output (regenerable by /graphify) ---
graphify-out/

# --- One-shot TEST stdout (transcript-derived text; same policy as results/) ---
results_test_stdout.log
