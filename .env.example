# Copy this file to `.env` and fill in your values.
# The real `.env` is gitignored and must NEVER be committed.

# LLM backend (decide later): course API / OpenAI-compatible / Ollama
LLM_BACKEND=          # course_api | openai | ollama
LLM_API_BASE=         # e.g. the course API endpoint URL
LLM_API_KEY=          # leave blank for local Ollama
LLM_MODEL=            # e.g. llama3, qwen2.5, or a course model name
